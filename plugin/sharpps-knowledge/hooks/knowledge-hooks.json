{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 2,
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/context.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 2,
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/context.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 2,
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/context.py"
            ]
          }
        ]
      }
    ]
  }
}
